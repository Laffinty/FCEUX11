scripts/logs/

# CTest artifacts (cost data, last-test logs)
Testing/

# Generated i18n build artefacts (qm files generated from src/drivers/Qt/lang/*.ts)
assets/i18n/

# hotfix5 translation working files (temporary scripts, TSV batches, analysis output)
output/

# Local scratch / unused first-level junk (matches "first level only" usage below)
/discard/

# Copyrighted FDS BIOS for local FDS testing (never commit)
/.dr/
tests/disksys.rom

# CMake Multi-Config target output shells (Debug/ MinSizeRel/ etc.) — empty placeholder dirs
*.dir/
