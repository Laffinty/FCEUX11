# FCEUX11 v0.3.0 — EditorConfig
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,c,hpp}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{cmake,txt}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{ps1,bat,cmd}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
